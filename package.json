{
  "name": "language-prism",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:public",
    "dev:public": "node --import tsx scripts/build/run.ts dev public",
    "dev:local": "node --import tsx scripts/build/run.ts dev local",
    "build": "npm run build:public",
    "build:public": "node --import tsx scripts/build/run.ts build public",
    "build:local": "node --import tsx scripts/build/run.ts build local",
    "preview:public": "node --import tsx scripts/build/run.ts preview public",
    "preview:local": "node --import tsx scripts/build/run.ts preview local",
    "validate:content": "node --import tsx scripts/content/validate.ts",
    "init:local": "node --import tsx scripts/content/init-local.ts",
    "content:new": "node --import tsx scripts/content/new.ts",
    "tts": "node --import tsx scripts/tts/run.ts",
    "privacy:check": "node --import tsx scripts/build/privacy.ts",
    "check": "astro check",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.ts"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "node": "^24.22.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
